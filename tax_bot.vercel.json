{
  "version": 2,
  "name": "cognitive-tax-bot",
  "builds": [
    { "src": "package.json", "use": "@vercel/next" }
  ],
  "env": {
    "DATABASE_URL": "@database_url",
    "NEXTAUTH_SECRET": "@nextauth_secret",
    "NEXTAUTH_URL": "@nextauth_url"
  },
  "routes": [
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
