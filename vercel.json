{
  "version": 2,
  "name": "postgres-app",
  "builds": [
    {
      "src": "public/index.php",
      "use": "@vercel/php"
    }
  ],
  "env": {
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "project_postgres",
    "DB_PORT": "5432",
    "DB_DATABASE": "@postgres_db",
    "DB_USERNAME": "@postgres_user",
    "DB_PASSWORD": "@postgres_password"
  },
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/public/index.php"
    }
  ]
}
